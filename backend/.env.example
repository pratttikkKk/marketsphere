# Server Environment Configuration
PORT=5002
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/marketsphere

# Cryptographic Token Security (Mandatory >= 32 chars in production)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_in_production

# Frontend Client Origin (Strict CORS)
CLIENT_URL=http://localhost:5173

# Admin Initial Bootstrap Credentials (CLI bootstrap:admin only)
ADMIN_EMAIL=admin@marketsphere.com
ADMIN_PASSWORD=Admin@SecurePassword2026!
ADMIN_FIRST_NAME=Platform
ADMIN_LAST_NAME=Administrator

# Payment Gateway Configuration (Razorpay / Sandbox)
PAYMENT_PROVIDER=SANDBOX
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Persistent Object Storage (Cloudinary / AWS S3)
IMAGE_STORAGE_PROVIDER=LOCAL
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Service Provider Configuration (SMTP)
EMAIL_PROVIDER=CONSOLE
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="MarketSphere" <no-reply@marketsphere.com>